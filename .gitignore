backend/whatsapp_api/baileys_store.json

# ── Frontend build / dependencias ────────────────────────
frontend/node_modules/
frontend/dist/

# ── Informe / documentos Word ────────────────────────────
*.docx
*.doc
~$*.docx

# ── PDF y presentaciones ─────────────────────────────────
*.pdf
*.pptx
*.ppt

# ── Notas, guías y prompts internos (solo en el equipo local) ─
