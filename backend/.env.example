# Copia este archivo a .env y rellena los valores

# Django
SECRET_KEY=cambia-esto-por-una-clave-secreta-aleatoria
DEBUG=False
ALLOWED_HOSTS=tu-dominio.railway.app,tudominio.com

# Base de datos (Railway lo pone automáticamente si añades PostgreSQL)
DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_bd

# URL del servicio WhatsApp (el otro servicio Railway)
WHATSAPP_API_URL=https://tu-whatsapp-service.railway.app

# Verificación de correo (Gmail) / MFA / recuperación de contraseña
# EMAIL_APP_PASSWORD es una "contraseña de aplicación" de Gmail (no tu
# contraseña normal): se genera en https://myaccount.google.com/apppasswords
EMAIL_USER=tu-correo@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_CODE_TTL_MINUTES=5
EMAIL_MAX_VERIFICATION_ATTEMPTS=5
EMAIL_MAX_QUEUE_ATTEMPTS=3
EMAIL_QUEUE_INTERVAL_MS=5000
EMAIL_MAX_ATTACHMENT_SIZE_MB=20
MFA_ISSUER=MassSend
MFA_WINDOW=1

# Pasarelas de pago (créditos) - PayPal Sandbox: https://developer.paypal.com
PAYPAL_CLIENT_ID=tu-client-id-sandbox
PAYPAL_CLIENT_SECRET=tu-client-secret-sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Pasarelas de pago (créditos) - PayPhone: https://payphone.app
PAYPHONE_TOKEN=tu-token-payphone
PAYPHONE_STORE_ID=tu-store-id-payphone
PAYPHONE_BASE_URL=https://pay.payphonetodoesposible.com

# Créditos gratis al crear la cuenta (para probar antes de comprar)
FREE_SIGNUP_CREDITS=10

# ── Modelo de IA local (Ollama) ───────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=60

# ── PocketBase (almacenamiento protegido de fotos/videos) ─────────
POCKETBASE_URL=http://localhost:8090
POCKETBASE_PUBLIC_URL=http://localhost:8090
POCKETBASE_COLLECTION=campaign_media
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=cambiar-esta-clave
